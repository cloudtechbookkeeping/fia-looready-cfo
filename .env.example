# Copy to .env and fill in. Never commit .env.

# Web address for Fia (needs a DNS A record pointing to the VPS: 76.13.209.167)
APP_DOMAIN=fia.cloudtechbookkeeping.com

# Random secret that signs logins. Make one with: openssl rand -hex 32
SESSION_SECRET=

# OpenClaw gateway (same VPS). host.docker.internal = the VPS itself, seen from inside the container.
OPENCLAW_URL=http://host.docker.internal:18789
# gateway.auth.token from the OpenClaw config (or OPENCLAW_GATEWAY_TOKEN)
OPENCLAW_TOKEN=
# Agent id of "Looready CFO". Run scripts/check-gateway.js to list the ids.
OPENCLAW_AGENT=looready-cfo

# 0 = OpenClaw remembers each chat itself (recommended). Set e.g. 20 to also resend the last 20 messages.
OPENCLAW_SEND_HISTORY=0

# Stay signed in on the phone for this many days
SESSION_DAYS=30

# Match these to the Traefik setup CloudTask already uses (see its docker-compose.yml labels)
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
